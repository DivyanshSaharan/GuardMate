# Copy to .env. Keep the actual key out of Git and browser code.
TINKER_API_KEY=
# Model tests have a persisted $0.25 estimated-usage cap. No automatic training.

# Required on Render. Use a database-scoped Atlas user and keep the URI server-side.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=guardmate
# Protect the hosted dashboard and API with a dedicated, randomly generated password.
# GUARDMATE_ACCESS_USERNAME=guardmate
# GUARDMATE_ACCESS_PASSWORD=

# Optional role-play sampler checkpoint. Unset/empty uses base Qwen.
# Configure only an evaluated /sampler_weights/ export, then restart the backend.
# GUARDMATE_SAMPLER_CHECKPOINT=tinker://YOUR-RUN-ID:train:0/sampler_weights/YOUR-CHECKPOINT
# Invalid/unavailable checkpoints do not fall back to base. See docs/model-selection.md.

# Optional local speech paths. setup_speech.py installs the Windows defaults.
# GUARDMATE_WHISPER_CLI=C:/path/to/whisper-cli.exe
# GUARDMATE_WHISPER_MODEL=C:/path/to/ggml-base.en.bin
# GUARDMATE_PIPER_MODEL=C:/path/to/en_US-ljspeech-high.onnx

# Optional speech limits. Docker sets threads=1 for small cloud instances.
# GUARDMATE_SPEECH_THREADS=1
# GUARDMATE_SPEECH_TIMEOUT=45
