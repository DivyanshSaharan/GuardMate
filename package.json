{
  "name": "guardmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal AI delivery assistant for PG life.",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test": "vitest run --config frontend/vitest.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1 --port 4173",
    "format": "prettier --write frontend package.json README.md .prettierrc.json",
    "format:check": "prettier --check frontend package.json README.md .prettierrc.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
